# Equipment & Tool Rental CRM - Backend Environment Variables
SECRET_KEY=django-insecure-rental-crm-dev-secret-key-2026-super-secure!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL by default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=rental_crm_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Set to True for zero-config local development without a running PostgreSQL instance
USE_SQLITE=True

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=120
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
